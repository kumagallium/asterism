# tagpr 設定 — https://github.com/Songmu/tagpr
# Graphium(provnote) の運用に倣う。asterism は Python マルチパッケージなので、
# versionFile はルートの VERSION（単一の真実源）。デスクトップアプリの
# tauri.conf.json も同じ版に同期させる（自動アップデータが「現在版 < 最新版」を
# 正しく比較できるように）。tagpr は tauri.conf.json の "version" フィールドを直接書換。
[tagpr]
versionFile = VERSION,desktop/src-tauri/tauri.conf.json
releaseBranch = main
vPrefix = true
changelog = true
# Version bump is decided per merged PR via labels (default is patch). Apply the
# "bump:minor" label to a feature/breaking PR to bump the minor version; "bump:major"
# for major. tagpr はこのラベルを「前回リリース以降にマージされた PR」から読み、
# リリース PR 側には自分の印として tagpr:major / tagpr:minor を付ける。
#
# 名前空間を bump: にしてあるのは事故防止。既定名の major/minor は Dependabot が
# semver-major/minor な更新 PR へ自動付与する名前と衝突し、actions の major 更新を
# マージしただけで次リリースが v1.0.0 に昇格する（2026-09-01 #501/#504 でヒヤリ）。
# tagpr:major / tagpr:minor も入力には使わない — tagpr 自身がリリース PR に付ける印なので
# 入力と出力が同名になり自己参照になりうる。
# NOTE: .tagpr is git-config (INI) format — values are bare strings, NOT arrays.
majorLabels = bump:major
minorLabels = bump:minor
