  {
    "name": "facts: an orphan _iri column with no sibling (e.g. a declared tool's sample_iri) stays as its own short-named column",
    "tool": {
      "name": "t",
      "title": "test",
      "output_kind": "facts",
      "item": {
        "sample_iri": { "var": "sample_iri" },
